# Run: python3 scripts/init_env.py
# The bootstrap writes a private .env with unique generated secrets.
# Never commit .env. Empty secret placeholders intentionally fail Compose checks.

METADATA_DB_HOST=postgres-metadata
METADATA_DB_PORT=5432
METADATA_DB_NAME=airflow_metadata
METADATA_DB_USER=airflow_metadata
METADATA_DB_PASSWORD=

WAREHOUSE_DB_HOST=postgres-target
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=email_warehouse
WAREHOUSE_DB_USER=email_loader
WAREHOUSE_DB_PASSWORD=

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=

# These ports bind to loopback only. Change them if another local stack uses them.
AIRFLOW_WEB_PORT=8080
WAREHOUSE_HOST_PORT=5433
